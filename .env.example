# ── Gemini ───────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model for the Live API (streaming audio → text)
GEMINI_MODEL=gemini-3.5-transcribe-live

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Gateway ───────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO

# ── On-demand sessions (/transcribe page) ─────────────
# Requires yt-dlp for YouTube URLs: pip install yt-dlp
# Direct video/stream URLs work without yt-dlp.

# ── Production dashboard ───────────────────────────────
# Set a secret token to enable the dashboard (/dashboard).
# Leave empty to disable.
DASHBOARD_TOKEN=change-me-before-production

# Alert thresholds (optional — these are the defaults)
LATENCY_WARN_MS=1500
LATENCY_CRIT_MS=4000
STALE_WARN_SEC=30
STALE_CRIT_SEC=120
